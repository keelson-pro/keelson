#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Keelson contributors (Fred Cooke)
#
# Kubernetes probe entry. Answers startup, readiness, or liveness from the
# two files the keelson controller publishes under /keelson/work/status:
#
#   heartbeat  written by the controller loop every tick
#   watchers   written by the watcher supervisor when the PID map changes
#
#   startup    heartbeat fresh AND every watch-target PID alive
#   readiness  every watch-target PID alive       (reads watchers only)
#   liveness   heartbeat fresh                    (reads heartbeat only)
#
# Exit 0 on pass, 1 on fail. No output on success; one log line on failure.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# The probe reads the controller's state; it does not author the controller's
# trail. Switching the file channel off before sourcing keeps the failure path
# from doing file I/O it does not need, on the one path already closest to its
# exec timeout. Set unconditionally, so an inherited env cannot re-enable it.
# Failures still go to stderr, which is what the kubelet puts in the event.
KEELSON_LOG_FILE_PATH=
# shellcheck source=lib/log.bash
source "${SCRIPT_DIR}/lib/log.bash"
# shellcheck source=lib/clock.bash
source "${SCRIPT_DIR}/lib/clock.bash"
# shellcheck source=lib/status.bash
source "${SCRIPT_DIR}/lib/status.bash"

usage() {
    cat <<'USAGE'
Usage: keelson-probe <startup|readiness|liveness>

Exits 0 if the requested probe passes, 1 otherwise.
USAGE
}

probe_liveness() {
    local max_age=${KEELSON_HEARTBEAT_MAX_AGE:?KEELSON_HEARTBEAT_MAX_AGE required}
    local file="$KEELSON_STATUS_DIR/heartbeat"
    if ! status_heartbeat_fresh "$max_age"; then
        log_error probe-liveness-fail max-age="$max_age" file="$file" \
            msg="Liveness probe failed: heartbeat in '$file' is older than ${max_age}s."
        return 1
    fi
}

probe_readiness() {
    local file="$KEELSON_STATUS_DIR/watchers"
    if ! status_all_watchers_alive; then
        log_error probe-readiness-fail file="$file" \
            msg="Readiness probe failed: not all watcher PIDs in '$file' are alive."
        return 1
    fi
    # A live PID only proves the watcher process exists. Each watcher
    # publishes whether its watch is actually streaming.
    if ! status_all_watchers_streaming; then
        log_error probe-readiness-fail file="$KEELSON_STATUS_DIR/watcher-<target>" \
            msg="Readiness probe failed: a watcher process is alive but its watch is not streaming; see the watcher-<target> files in '$KEELSON_STATUS_DIR'."
        return 1
    fi
}

probe_startup() {
    probe_liveness || return 1
    probe_readiness || return 1
}

main() {
    case "${1:-}" in
        startup)   probe_startup ;;
        readiness) probe_readiness ;;
        liveness)  probe_liveness ;;
        -h|--help) usage ;;
        *)         usage >&2; return 64 ;;
    esac
}

main "$@"
