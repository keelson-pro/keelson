#!/usr/bin/env bash
# Keelson main entrypoint. Long-running: watch + periodic scan.
# Logic lives in lib/; this file orchestrates.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/log.bash
source "${SCRIPT_DIR}/lib/log.bash"
# shellcheck source=lib/clock.bash
source "${SCRIPT_DIR}/lib/clock.bash"
# shellcheck source=lib/validate.bash
source "${SCRIPT_DIR}/lib/validate.bash"
# shellcheck source=lib/policy.bash
source "${SCRIPT_DIR}/lib/policy.bash"
# shellcheck source=lib/image.bash
source "${SCRIPT_DIR}/lib/image.bash"
# shellcheck source=lib/annotations.bash
source "${SCRIPT_DIR}/lib/annotations.bash"
# shellcheck source=lib/workload.bash
source "${SCRIPT_DIR}/lib/workload.bash"
# shellcheck source=lib/registry.bash
source "${SCRIPT_DIR}/lib/registry.bash"
# shellcheck source=lib/eligibility.bash
source "${SCRIPT_DIR}/lib/eligibility.bash"
# shellcheck source=lib/managedfields.bash
source "${SCRIPT_DIR}/lib/managedfields.bash"
# shellcheck source=lib/update.bash
source "${SCRIPT_DIR}/lib/update.bash"
# shellcheck source=lib/state.bash
source "${SCRIPT_DIR}/lib/state.bash"
# shellcheck source=lib/scan.bash
source "${SCRIPT_DIR}/lib/scan.bash"
# shellcheck source=lib/queue.bash
source "${SCRIPT_DIR}/lib/queue.bash"
# shellcheck source=lib/inventory.bash
source "${SCRIPT_DIR}/lib/inventory.bash"
# shellcheck source=lib/status.bash
source "${SCRIPT_DIR}/lib/status.bash"
# shellcheck source=lib/watch.bash
source "${SCRIPT_DIR}/lib/watch.bash"
# shellcheck source=lib/loop.bash
source "${SCRIPT_DIR}/lib/loop.bash"

usage() {
    cat <<'USAGE'
Usage: keelson [--help]

Run the Keelson controller. Streams watch events for managed workloads,
runs a periodic full scan, and patches workloads when a newer tag meets
the configured policy.

Configuration is via env (see KEELSON_* in Configuration.md).
USAGE
}

config_line() {
    local pad
    printf -v pad '%-30s' "$1"
    log_info_always config setting="$1" value="$2" msg="  $pad = $2"
}

# Every setting Keelson read, once, at boot. A pod behaving differently from
# its neighbour is usually configured differently from it, and this is the
# cheapest way to see that without reaching for the Deployment.
log_boot_config() {
    log_info_always config-header msg="Keelson configuration from environment:"
    config_line scope "$KEELSON_SCOPE"
    if [ "$KEELSON_SCOPE" = "namespace" ]; then
        config_line namespace "${KEELSON_NAMESPACE:-}"
    fi
    config_line config-mode "$KEELSON_CONFIG_MODE"
    config_line watched-kinds "$KEELSON_WATCHED_KINDS"
    config_line dry-run "${KEELSON_DRY_RUN:-0}"
    config_line respect-sa-pull-secrets "$KEELSON_RESPECT_SA_PULL_SECRETS"
    config_line field-manager-strategy-owned "$KEELSON_FIELD_MANAGER_STRATEGY_OWNED"
    config_line field-manager-strategy-unowned "$KEELSON_FIELD_MANAGER_STRATEGY_UNOWNED"
    config_line state-configmap "$KEELSON_STATE_CONFIGMAP"
    config_line registries-file "${KEELSON_REGISTRIES_FILE:-}"
    config_line tick-interval "$KEELSON_TICK_INTERVAL"
    config_line reconcile-interval "$KEELSON_RECONCILE_INTERVAL"
    config_line registry-poll-interval-default "$KEELSON_REGISTRY_POLL_INTERVAL_DEFAULT"
    config_line full-refresh-interval "$KEELSON_FULL_REFRESH_INTERVAL"
    config_line heartbeat-max-age "$KEELSON_HEARTBEAT_MAX_AGE"
    config_line watcher-respawn-backoff-max "$KEELSON_WATCHER_RESPAWN_BACKOFF_MAX"
    config_line watcher-respawn-healthy-reset "$KEELSON_WATCHER_RESPAWN_HEALTHY_RESET"
    config_line watcher-reconnect-initial "$KEELSON_WATCHER_RECONNECT_INITIAL"
    config_line watcher-reconnect-max "$KEELSON_WATCHER_RECONNECT_MAX"
    config_line watcher-reconnect-reset "$KEELSON_WATCHER_RECONNECT_RESET"
    config_line log-level "$KEELSON_LOG_LEVEL"
    config_line log-format "$KEELSON_LOG_FORMAT"
    config_line log-file-path "${KEELSON_LOG_FILE_PATH:-}"
    config_line log-file-max-bytes "$KEELSON_LOG_FILE_MAX_BYTES"
    config_line log-file-keep "$KEELSON_LOG_FILE_KEEP"
    config_line log-managed-workloads "$KEELSON_LOG_MANAGED_WORKLOADS"
    config_line log-repeat-interval-debug "$KEELSON_LOG_DEBUG_REPEAT_INTERVAL"
    config_line log-repeat-interval-info "$KEELSON_LOG_INFO_REPEAT_INTERVAL"
    config_line log-repeat-interval-warn "$KEELSON_LOG_WARN_REPEAT_INTERVAL"
    config_line log-repeat-interval-error "$KEELSON_LOG_ERROR_REPEAT_INTERVAL"
}

shutdown() {
    local sig=${1:-unknown}
    log_info_always shutdown signal="$sig" \
        msg="Keelson shutting down on signal $sig."
    loop_kill_children
    exit 0
}

main() {
    case "${1:-}" in
        -h|--help) usage; return 0 ;;
    esac

    validate_config

    state_own_namespace || true
    log_info_always boot \
        version="${KEELSON_VERSION:-0.0.0-DEV-VERSION}" \
        ns="${STATE_NAMESPACE:-unknown}" \
        msg="Keelson ${KEELSON_VERSION:-0.0.0-DEV-VERSION} booting in ns '${STATE_NAMESPACE:-unknown}'."
    log_boot_config

    trap 'shutdown SIGTERM' TERM
    trap 'shutdown SIGINT' INT

    queue_init
    inventory_init
    if ! state_init; then
        log_warn state-init-failed \
            configmap="${KEELSON_STATE_CONFIGMAP:-keelson-state}" \
            ns="${STATE_NAMESPACE:-${KEELSON_STATE_NAMESPACE:-unknown}}" \
            continuing-without-trigger-state=1 \
            msg="State init failed, could not create ConfigMap '${KEELSON_STATE_CONFIGMAP:-keelson-state}' in '${STATE_NAMESPACE:-${KEELSON_STATE_NAMESPACE:-unknown}}'; continuing without trigger-state."
    fi

    loop_run
}

main "$@"
